# Copyright (c) Liam Suorsa and Mika Suorsa
# Exempel pa separat publik utvecklingsmiljo for dev.utbildningsintyg.se

APP_ENV=development
DEV_MODE=true
DISABLE_EMAILS=true

# Flask-hemligheter och hashning maste vara separata fran produktion.
SECRET_KEY=byt-till-en-unik-dev-hemlighet
HASH_SALT=byt-till-ett-eget-dev-salt

# Devadmin anvander egna credentials och far inte dela prodinloggning.
DEV_ADMIN_USERNAME=dev_admin
DEV_ADMIN_PASSWORD=byt-till-ett-starkt-dev-losenord

# Syntetiskt privatkonto for test.
DEV_PRIVATE_USER_NAME=Dev Testperson
DEV_PRIVATE_USER_EMAIL=dev.private.user@example.com
DEV_PRIVATE_USER_PERSONNUMMER=199001011234
DEV_PRIVATE_USER_PASSWORD=DevPrivatLosenord1!

# Syntetiskt foretagskonto for test.
DEV_COMPANY_NAME=Dev Exempelbolag AB
DEV_COMPANY_EMAIL=dev.company@example.com
DEV_COMPANY_ORGNR=5561234567
DEV_COMPANY_PASSWORD=DevForetagLosenord1!

# UI och cookies
DEV_UI_LABEL=Utvecklingsmiljö
SESSION_COOKIE_NAME=jk_dev_session
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_DOMAIN=
PREFERRED_URL_SCHEME=https

# Devdatabas i egen volym inne i containern.
DATABASE_URL=sqlite:////app/dev-data/dev.sqlite

# Publikt Traefik-nat som redan finns pa servern.
PUBLIC_NETWORK_NAME=jk_public_net
TRUSTED_PROXY_COUNT=1

# Drift
WEB_CONCURRENCY=1
THREADS=4
LOG_LEVEL=INFO

# Lamna SMTP-hemligheter tomma i dev. DISABLE_EMAILS=true ska vara tillrackligt.
# ADMIN_EMAIL kan peka pa en intern testadress om loggning behovs.
ADMIN_EMAIL=dev-admin@example.com

# Copyright (c) Liam Suorsa and Mika Suorsa

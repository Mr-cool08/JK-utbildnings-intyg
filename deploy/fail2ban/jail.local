# Fail2ban-jails för att i första hand skydda SSH på origin-servern
[DEFAULT]
bantime = 1h
findtime = 10m
maxretry = 5
backend = polling
ignoreip = 127.0.0.1/8 ::1

[sshd]
enabled = true
port = ssh
mode = normal
chain = INPUT
banaction = iptables-multiport
logpath = /var/log/host/auth.log

